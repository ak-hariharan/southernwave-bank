{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"homemfe": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/homemfe",
			"sourceRoot": "projects/homemfe/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "projects/homemfe/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/homemfe/public",
								"output": "."
							},
							{
								"glob": "**/*",
								"input": "dist/shared/assets",
								"output": "assets/shared"
							}
						],
						"styles": [
							"projects/homemfe/src/styles.scss"
						],
						"stylePreprocessorOptions": {
							"includePaths": [
								"projects/shared/src/lib/styles"
							]
						},
						"main": "projects/homemfe/src/main.ts",
						"outputPath": "dist/homemfe",
						"index": "projects\\homemfe\\src\\index.html",
						"extraWebpackConfig": "projects/homemfe/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "12kB",
									"maximumError": "16kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/homemfe/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "homemfe:build:production",
							"extraWebpackConfig": "projects/homemfe/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "homemfe:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200,
						"publicHost": "http://localhost:4200",
						"extraWebpackConfig": "projects/homemfe/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/homemfe/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/homemfe/public"
							}
						],
						"styles": [
							"projects/homemfe/src/styles.scss"
						]
					}
				}
			}
		},
		"shared": {
			"projectType": "library",
			"root": "projects/shared",
			"sourceRoot": "projects/shared/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"configurations": {
						"production": {
							"tsConfig": "projects/shared/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/shared/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "projects/shared/tsconfig.spec.json",
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						]
					}
				}
			}
		},
		"dashboardmfe": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/dashboardmfe",
			"sourceRoot": "projects/dashboardmfe/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"tsConfig": "projects/dashboardmfe/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/dashboardmfe/public",
								"output": "."
							}
						],
						"styles": [
							"projects/dashboardmfe/src/styles.scss"
						],
						"main": "projects/dashboardmfe/src/main.ts",
						"outputPath": "dist/dashboardmfe",
						"index": "projects\\dashboardmfe\\src\\index.html",
						"extraWebpackConfig": "projects/dashboardmfe/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/dashboardmfe/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "dashboardmfe:build:production",
							"extraWebpackConfig": "projects/dashboardmfe/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "dashboardmfe:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4201,
						"publicHost": "http://localhost:4201",
						"extraWebpackConfig": "projects/dashboardmfe/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "projects/dashboardmfe/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/dashboardmfe/public"
							}
						],
						"styles": [
							"projects/dashboardmfe/src/styles.scss"
						]
					}
				}
			}
		}
	}
}